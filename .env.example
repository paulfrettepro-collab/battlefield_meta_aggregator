# TRACKER.GG API# ============================================

TRACKER_GG_API_KEY=your_api_key_here# Battlefield 6 Meta Aggregator - Configuration

TRACKER_GG_BASE_URL=https://public-api.tracker.gg/v2# ============================================

# Ce fichier est un MODÈLE - NE PAS mettre de vraies valeurs ici

# MINIO (OBJECT STORAGE - Local S3-compatible)# 

MINIO_ENDPOINT=localhost:9000# INSTRUCTIONS :

MINIO_ACCESS_KEY=minioadmin# 1. Copier ce fichier : cp .env.example .env

MINIO_SECRET_KEY=minioadmin# 2. Remplir .env avec vos vraies valeurs

MINIO_BUCKET_BRONZE=bronze# 3. Ne JAMAIS commiter le fichier .env (il est dans .gitignore)

MINIO_BUCKET_SILVER=silver

MINIO_BUCKET_GOLD=gold# ============================================

# TRACKER.GG API (⭐ REQUIS - PRIORITÉ #1)

# BIGQUERY (DATA WAREHOUSE - Google Cloud)# ============================================

GCP_PROJECT_ID=your-gcp-project-id# Obtenez votre clé sur : https://tracker.gg/developers/apps

GCP_DATASET_ID=bf6_meta# 1. Créer un compte Tracker.gg

GCP_CREDENTIALS_PATH=path/to/service-account.json# 2. Aller sur https://tracker.gg/developers/apps

# 3. Créer une app

# EXTRACTION / SCRAPING# 4. Copier la clé API (format : TRN-Api-Key)

USER_AGENT=BattlefieldMetaAggregator/1.0TRACKER_GG_API_KEY=votre_cle_api_ici

SCRAPING_DELAY=2

MAX_RETRIES=3# ============================================

# MINIO (DATA LAKE BRONZE)

# LOGS AND MONITORING# ============================================

LOG_LEVEL=INFO# Configuration par défaut (docker-compose.yml)

DEBUG=False# Pas besoin de modifier sauf si vous changez docker-compose.yml

LOG_DIR=data/logsMINIO_ENDPOINT=localhost:9000

MINIO_ACCESS_KEY=minioadmin

# NOTIFICATIONS (Optional)MINIO_SECRET_KEY=minioadmin

DISCORD_WEBHOOK_URL=MINIO_BUCKET=battlefield-bronze

EMAIL_NOTIFICATIONS_ENABLED=FalseMINIO_SECURE=False



# CRON SCHEDULE# ============================================

EXTRACTION_SCHEDULE=0 2 * * 0  # Sundays at 2am (UTC)# BIGQUERY (PHASE 2 - Optionnel pour l'instant)

# ============================================
# À remplir uniquement quand vous passerez à la Phase 2
# GOOGLE_CLOUD_PROJECT=battlefield-meta
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/bigquery-key.json

# ============================================
# EXTRACTION CONFIG
# ============================================
# Nombre de joueurs à extraire du leaderboard (max 100)
MAX_PLAYERS=100

# Délai entre requêtes API (secondes) - Respecter rate limit
RATE_LIMIT_DELAY=1.0

# Anonymisation (hash des pseudos)
ANONYMIZE_USERNAMES=True

# ============================================
# AIRFLOW (PHASE 5 - Optionnel)
# ============================================
# À configurer pour orchestration automatique quotidienne
# AIRFLOW__CORE__EXECUTOR=LocalExecutor
# AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow

# Mode de l'application
ENVIRONMENT=development  # development, staging, production

# Port de l'API
API_PORT=8000

# CORS Origins autorisés (séparés par des virgules)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================
# FRONTEND (Next.js)
# ============================================
# URL de l'API backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================
# DOCKER
# ============================================
# Configuration SQL Server pour Docker
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
ACCEPT_EULA=Y
MSSQL_PID=Developer

# ============================================
# DATA LAKE (MinIO / Azure Blob Storage)
# ============================================
# MinIO (local development)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=battlefield-data-lake
MINIO_SECURE=false

# Azure Blob Storage (production)
AZURE_STORAGE_CONNECTION_STRING=your_azure_connection_string_here
AZURE_STORAGE_CONTAINER=battlefield-data-lake

# ============================================
# BASE DE DONNÉES VECTORIELLE
# ============================================
# ChromaDB (local/dev)
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
CHROMADB_PERSIST_DIR=./chroma_data

# Qdrant (production - optionnel)
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=battlefield_weapons

# Embeddings Provider (sentence-transformers ou openai)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# OpenAI (si utilisé pour embeddings)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# REDIS (CACHE)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ============================================
# LOGS ET MONITORING (OPTIONNEL)
# ============================================
# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Activer les logs détaillés
DEBUG=False

# ============================================
# AUTHENTIFICATION (SI NÉCESSAIRE)
# ============================================
# GitHub Token pour accès API (si tu scrapes GitHub)
GITHUB_TOKEN=your_github_token_here

# Discord Webhook pour notifications (optionnel)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook

# ============================================
# AUTRES
# ============================================
# Email de contact (pour respecter l'éthique du scraping)
CONTACT_EMAIL=your.email@example.com
