# ============================================
# .env.example - Variables d'environnement
# ============================================
# Ce fichier est un MODÈLE qui montre quelles variables sont nécessaires
# ⚠️ NE JAMAIS mettre de vraies valeurs ici (c'est versionné sur GitHub)
# 
# INSTRUCTIONS :
# 1. Copier ce fichier : cp .env.example .env
# 2. Remplir .env avec tes vraies valeurs
# 3. Ne JAMAIS commiter le fichier .env (il est dans .gitignore)

# ============================================
# BASE DE DONNÉES (SQL Server)
# ============================================
# Format : mssql+pyodbc://utilisateur:motdepasse@hote:port/nom_base?driver=...
DATABASE_URL=mssql+pyodbc://user:password@localhost:1433/battlefield_meta?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Paramètres individuels (alternative)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=battlefield_meta
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_DRIVER=ODBC Driver 18 for SQL Server

# ============================================
# API ET SCRAPING
# ============================================
# Clés API pour les sources de données (si nécessaires)
API_KEY_SOURCE_1=your_api_key_here
API_KEY_SOURCE_2=your_api_key_here

# User-Agent pour le scraping (identifie ton bot)
USER_AGENT=BattlefieldMetaAggregator/1.0 (contact@example.com)

# Délai entre les requêtes (en secondes, pour respecter les sites)
SCRAPING_DELAY=2

# ============================================
# FASTAPI / BACKEND
# ============================================
# Clé secrète pour JWT, sessions, etc.
SECRET_KEY=your-super-secret-key-change-this-in-production

# Mode de l'application
ENVIRONMENT=development  # development, staging, production

# Port de l'API
API_PORT=8000

# CORS Origins autorisés (séparés par des virgules)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================
# FRONTEND (Next.js)
# ============================================
# URL de l'API backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================
# DOCKER
# ============================================
# Configuration SQL Server pour Docker
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
ACCEPT_EULA=Y
MSSQL_PID=Developer

# ============================================
# DATA LAKE (MinIO / Azure Blob Storage)
# ============================================
# MinIO (local development)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=battlefield-data-lake
MINIO_SECURE=false

# Azure Blob Storage (production)
AZURE_STORAGE_CONNECTION_STRING=your_azure_connection_string_here
AZURE_STORAGE_CONTAINER=battlefield-data-lake

# ============================================
# LOGS ET MONITORING (OPTIONNEL)
# ============================================
# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Activer les logs détaillés
DEBUG=False

# ============================================
# AUTHENTIFICATION (SI NÉCESSAIRE)
# ============================================
# GitHub Token pour accès API (si tu scrapes GitHub)
GITHUB_TOKEN=your_github_token_here

# Discord Webhook pour notifications (optionnel)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook

# ============================================
# AUTRES
# ============================================
# Email de contact (pour respecter l'éthique du scraping)
CONTACT_EMAIL=your.email@example.com
